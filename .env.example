# GT Café house terminal (E11) — server-only secrets. Never NEXT_PUBLIC.
# Copy to .env.local for local dev; set the same three in Vercel for production.
# With none of these set the terminal route answers 503 TERMINAL_OFFLINE and the
# build still passes keyless — nothing here is required to build.

# Groq API key (free tier) — powers the terminal's chat model, server-side only.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Upstash Redis REST URL — backs the terminal's rate limiting.
# Create a Redis database at https://console.upstash.com and copy its REST URL.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token — the read/write token for the database above.
# ALSO backs the anonymized event pipeline (page-view + chat counters, question
# ring buffer). No extra service needed — same Redis as the rate limiter.
UPSTASH_REDIS_REST_TOKEN=

# ── Admin terminal (E11) — server-only. Absent → admin login returns 503,
# never a bypass; the public site is unaffected. ──────────────────────────────

# Scrypt digest of the admin passphrase, formatted `<N>:<r>:<p>:<salt>:<hash>`
# (the legacy `salt:hash` shape still verifies). Generate locally — plaintext is
# never stored/logged, and passphrases under 16 characters are refused:
#   pnpm hash-passphrase
# Changing this value also invalidates every admin session (the session key is
# derived from it — see lib/adminSession.ts).
ADMIN_PASSPHRASE_SCRYPT=

# Root key for admin session cookies (combined with a hash of the passphrase
# digest above to derive the actual signing key). Use a long random value:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# ALSO the root of the café terminal's transcript-signing key — a SEPARATE key
# is derived from it (lib/transcriptSignature.ts), never this value itself, so
# the public tags handed to visitors can say nothing about admin cookies. No new
# secret to provision. With this unset the terminal still serves guests, but it
# can authenticate no assistant history, so each question is answered without
# the previous reply for context.
ADMIN_SESSION_SECRET=

# ── Live lobby presence (E12) — PUBLIC, not a secret. ────────────────────────
# WebSocket URL of the presence Worker (workers/presence, deployed separately
# at live.suryapugaz.com). Unset → the site never opens a socket and the lobby
# renders its static list exactly as before. NEXT_PUBLIC_* is inlined at BUILD
# time, so in production it must be a Workers Builds *build variable* on
# surya-site, not a runtime var (see workers/presence/README.md).
NEXT_PUBLIC_PRESENCE_URL=wss://live.suryapugaz.com/room

# ── Cloudflare Access re-check (admin routes) — server-only RUNTIME vars. ────
# /api/admin/login and /api/admin/data verify the Cf-Access-Jwt-Assertion header
# Access adds to every request it lets through (lib/cfAccess.ts). Any of these
# unset → both routes answer 503 ADMIN_NOT_CONFIGURED (never a bypass). Set them
# as Worker runtime variables/secrets on surya-site, NOT build variables. Keep
# the AUD tag and email out of the repo — this file stays blank.
# Team domain, e.g. <team>.cloudflareaccess.com (must end in .cloudflareaccess.com).
CF_ACCESS_TEAM_DOMAIN=
# The Access application's "Application Audience (AUD) Tag".
CF_ACCESS_AUD=
# The only identity allowed through (compared case-insensitively).
ADMIN_ACCESS_EMAIL=
